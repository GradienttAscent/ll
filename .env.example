# GEMINI_API_KEY: Required for live Gemini AI calls.
# Place this file content in .env or .env.local for local development.
GEMINI_API_KEY="your api key"

# APP_URL: The URL where this applet is hosted.
# Optional application URL for future hosted integrations.
APP_URL="MY_APP_URL"

# LAZYLIFT_CORS_ORIGINS: Comma-separated list of browser origins allowed to call this API
#   (backend). Required in production, where the frontend is hosted on a different domain
#   than the API. Use the exact Vercel origin, e.g.
#   "https://lazylift.vercel.app,https://lazylift-abc123.vercel.app"
#   "*" also works and is safe here because auth uses a Bearer token, not cookies.
#   If unset, only loopback origins (localhost / 127.0.0.1) are allowed, which is what
#   local development needs.
LAZYLIFT_CORS_ORIGINS="https://lazylift.vercel.app"

# VITE_API_BASE_URL: Backend origin the browser calls (frontend). Leave unset locally so
#   requests stay same-origin; set it on Vercel to the Render backend origin, e.g.
#   "https://lazylift-backend.onrender.com".
#   Vite inlines this at BUILD time, so it must be defined as a Vercel environment
#   variable, not only at runtime.
VITE_API_BASE_URL="https://lazylift-backend.onrender.com"

# Optional overrides:
# LAZYLIFT_DATA_DIR: Directory for the SQLite file (default: <project>/data).
# LAZYLIFT_DEMO_EMAIL / LAZYLIFT_DEMO_PASSWORD: demo account used by the web client
#   for automatic sign-in. The app auto-logs-in with the demo user on load.
#   Default demo credentials: demo@lazylift.app / demo1234
# PORT (or APP_PORT): HTTP port for the server (default: 3000).